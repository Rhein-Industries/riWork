# A chat switched to Muse through the chat host: the first message carries the conversation so far
# (handoff instructions the host reads from the chat's context.md) as a leading part, displayText is
# the typed message, and Muse's echo of the whole input never becomes the user's message.
{"type":"expect","frame":{"id":"<any>","method":"initialize","params":{"clientInfo":{"name":"riwork"},"capabilities":{"requestedCapabilities":["sessionMcp"]}}},"reply":[{"jsonrpc":"2.0","id":"$id","result":{"serverInfo":{"name":"muse","version":"1.4.7"},"grantedCapabilities":["sessionMcp"]}}]}
{"type":"expect","frame":{"method":"initialized"},"reply":[]}
{"type":"expect","frame":{"id":"<any>","method":"session/start","params":{"commandId":"<any>","workspaceRoot":"<any>","approvalMode":"promptUnmatched"}},"reply":[{"jsonrpc":"2.0","id":"$id","result":{"session":{"sessionId":"sess-1","activeTurnId":null,"turnCount":0},"viewCursor":""}}]}
{"type":"expect","frame":{"id":"<any>","method":"model/list","params":{"sessionId":"sess-1"}},"reply":[{"jsonrpc":"2.0","id":"$id","result":{"providerId":"fake","profileId":null,"source":"fakeCatalog","models":[]}}]}
{"type":"expect","frame":{"id":"<any>","method":"turn/start","params":{"commandId":"<any>","sessionId":"sess-1","input":"<any>","displayText":"hello"}},"reply":[{"jsonrpc":"2.0","id":"$id","result":{"commandId":"$command_id","status":"accepted","turnId":"turn-1","startedNewTurn":true,"disposition":"started"}},{"jsonrpc":"2.0","method":"turn/started","params":{"sessionId":"sess-1","turnId":"turn-1","commandId":"c"}},{"jsonrpc":"2.0","method":"item/completed","params":{"sessionId":"sess-1","item":{"revision":1,"status":"completed","itemId":"um-1","kind":"userMessage","turnId":"turn-1","text":"This chat was started with another agent ... remember the blue door ...hello","commandId":"$command_id"}}},{"jsonrpc":"2.0","method":"item/completed","params":{"sessionId":"sess-1","item":{"revision":1,"status":"completed","itemId":"msg-1","kind":"agentMessage","turnId":"turn-1","text":"the blue door"}}},{"jsonrpc":"2.0","method":"turn/completed","params":{"sessionId":"sess-1","turnId":"turn-1","terminal":"completed"}}]}
