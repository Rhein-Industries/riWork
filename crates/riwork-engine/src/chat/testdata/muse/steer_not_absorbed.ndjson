# What Muse 1.4.7 answers a steer that reaches a turn after its last model call (seen on muse serve
# --provider echo): status accepted, but turnId is the steer's own id, not the turn's, and the
# session log records the submit rejected already_terminal. Delivery is not certain from the wire,
# so the message is not sent again: the user gets it back in a notice.
{"type":"expect","frame":{"id":"<any>","method":"initialize","params":{"clientInfo":{"name":"riwork"},"capabilities":{"requestedCapabilities":["sessionMcp"]}}},"reply":[{"jsonrpc":"2.0","id":"$id","result":{"serverInfo":{"name":"muse","version":"1.4.7"},"grantedCapabilities":["sessionMcp"]}}]}
{"type":"expect","frame":{"method":"initialized"},"reply":[]}
{"type":"expect","frame":{"id":"<any>","method":"session/start","params":{"commandId":"<any>","workspaceRoot":"<any>","approvalMode":"promptUnmatched"}},"reply":[{"jsonrpc":"2.0","id":"$id","result":{"session":{"sessionId":"sess-1","activeTurnId":null,"turnCount":0},"viewCursor":""}}]}
{"type":"expect","frame":{"id":"<any>","method":"model/list","params":{"sessionId":"sess-1"}},"reply":[{"jsonrpc":"2.0","id":"$id","result":{"providerId":"fake","profileId":null,"source":"fakeCatalog","models":[]}}]}
{"type":"expect","frame":{"id":"<any>","method":"turn/start","params":{"commandId":"<any>","sessionId":"sess-1","input":[{"type":"text","text":"one"}]}},"reply":[{"jsonrpc":"2.0","id":"$id","result":{"commandId":"$command_id","status":"accepted","turnId":"turn-1","startedNewTurn":true,"disposition":"started"}},{"jsonrpc":"2.0","method":"turn/started","params":{"sessionId":"sess-1","turnId":"turn-1","commandId":"c"}}]}
{"type":"expect","frame":{"id":"<any>","method":"turn/steer","params":{"expectedTurnId":"turn-1","input":[{"type":"text","text":"more"}]}},"reply":[{"jsonrpc":"2.0","id":"$id","result":{"commandId":"$command_id","status":"accepted","turnId":"$command_id"}},{"jsonrpc":"2.0","method":"turn/completed","params":{"sessionId":"sess-1","turnId":"turn-1","terminal":"completed"}}]}
